# Токен чат-бота MAX. Получается в кабинете управления ботом.
BOT_TOKEN=

# API-ключ Yandex AI Studio и идентификатор каталога Yandex Cloud.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Параметры YandexGPT. При необходимости замените модель на используемую в облаке.
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_MODEL=yandexgpt/latest
YANDEX_TIMEOUT=25
YANDEX_MAX_RETRIES=0

# Безопасность: для рабочего режима авторизация сотрудников должна быть включена,
# тестовый режим — выключен.
SECURITY_ENABLED=true
TESTING_AUTH_MODE=false

# Необязательный перечень групп через запятую.
# GROUPS=ЭЛС-21,ЭЛС-22

# Пути по умолчанию. В Docker Compose DATA_FILE и FLOW_FILE задаются отдельно.
# DATA_FILE=bot_data.json
# FLOW_FILE=report_structure.json
